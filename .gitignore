*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Local development
local/
scratch/

# Note: state.json and task_history.json ARE committed
# because we want to track agent state across runs

# Google API credentials — never commit
automation/data/google_credentials.json
automation/data/google_token.json
automation/data/service_account.json

# Graphify output (rebuilt by git hook)
graphify-out/

# OneDrive sync conflict copies (this repo syncs across 2 PCs; OneDrive
# creates "-HANY-PC" suffixed conflict copies of any file touched on both
# machines near-simultaneously, including inside .git/ itself). Never
# real content - ignoring so a directory-scoped `git add` can never
# accidentally sweep them into a commit again.
*-HANY-PC.*
*-HANY-PC

# Local archive of recovered/superseded files (never publish to GitHub)
.archive/
